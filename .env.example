# Copy to .env.local and fill in. Nothing here is required for `npm run build`:
# without the Firebase keys sign-in shows an error, without the Gemini key the
# AI matching and chat fall back to a friendly message.

# Firebase web app config (Firebase console > Project settings > Your apps).
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google AI Studio key for Genkit/Gemini (server-side only, read at runtime).
GEMINI_API_KEY=
